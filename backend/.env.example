# ==============================================================================
# Heart Kids Wear (心童裝) — Backend Environment Configuration Template
# ==============================================================================

# Security & Authentication
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local SQLite (Default for offline dev):
DATABASE_URL=sqlite:///./backend/data/heart_kids_wear.db
# Cloud PostgreSQL (Supabase / Neon / Railway in production):
# DATABASE_URL=postgresql://postgres.hghehxrlcylseaefrgxn:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Cloudflare R2 Object Storage & CDN (Product Photos, Size Charts & Banners)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=heart-kids-wear-media
R2_PUBLIC_DOMAIN=https://pub-your_bucket_id.r2.dev

# Business Rules & Configuration
PAYMENT_GATEWAY_ENABLED=false
STORE_CREDIT_AUTO_REFUND=true
OVERDUE_TRACKING_ENABLED=true

# Transactional Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=service@heartkidswear.com
