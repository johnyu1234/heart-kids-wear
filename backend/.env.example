# Security
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local SQLite:
DATABASE_URL=sqlite:///./backend/data/heart_kids_wear.db
# Or Production PostgreSQL (Supabase / Neon / Railway):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Business Configuration
PAYMENT_GATEWAY_ENABLED=false
STORE_CREDIT_AUTO_REFUND=true
OVERDUE_TRACKING_ENABLED=true

# Transactional Email (Resend)
RESEND_API_KEY=
SENDER_EMAIL=noreply@heartkidswear.com
